{
  "name": "steam-sale-notifier",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cloudflare Worker that announces temporarily free Steam games to Discord",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev --test-scheduled",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261101.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7",
    "wrangler": "^4.156.0"
  }
}
